# Kopieren nach .env.local und Werte eintragen. Niemals echte Werte hier committen.

# --- Milestone 0 (aktiv) ---
# Supabase: Settings > API. Basis-URL OHNE /rest/v1/ am Ende.
NEXT_PUBLIC_SUPABASE_URL=
# "anon public"-Key (öffentlich unbedenklich, RLS schützt die Daten)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Milestone 3: Lead Intelligence (ohne diese Werte läuft die App, nur die KI-Funktionen melden "nicht eingerichtet") ---
# console.anthropic.com > API Keys. Nur serverseitig, nie ins Repo.
ANTHROPIC_API_KEY=
# Modellnamen stehen nur hier, nie im Code. "capable" für Analyse, "cheap" für einfache Textbausteine (ab Milestone 4).
AI_MODEL_CAPABLE=claude-opus-5-5
AI_MODEL_CHEAP=claude-haiku-5-5
# Kostenschutz: KI-Aufrufe pro Stunde (alle zusammen) und größter erlaubter Einzelaufruf in Euro
AI_MAX_RUNS_PER_HOUR=20
AI_MAX_COST_PER_RUN_EUR=1
# Dollar-Euro-Kurs für die Kostenanzeige
AI_USD_EUR_RATE=0.92
# Optional, aber empfohlen: ohne Key ist das gemeinsame anonyme Google-Kontingent oft erschöpft.
# console.cloud.google.com > "PageSpeed Insights API" aktivieren > Anmeldedaten > API-Schlüssel
PAGESPEED_API_KEY=

# --- Spätere Milestones (noch nicht verwendet, hier nur zur Orientierung) ---
# M5+  SUPABASE_SERVICE_ROLE_KEY=      # NUR serverseitig, nur für den Domain-Status-Cron (docs/07-datenbankplanung.md)
# M4+  AI_MAX_COST_PER_DEMO_EUR=
# M5+  VERCEL_API_TOKEN=
# M5+  REVALIDATE_SECRET=
